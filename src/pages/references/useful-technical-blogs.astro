---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeftRail from '../../components/LeftRail.astro';
import Prose from '../../components/Prose.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'useful-technical-blogs');
if (!entry) throw new Error("Missing content collection entry: pages/useful-technical-blogs");
const { Content } = await render(entry);
---
<BaseLayout title={`${entry.data.title} — Shubham Bansal`} description={entry.data.description}>
  <div class="layout"><LeftRail />
    <main>
      <Prose><Content /></Prose>
    </main>
  </div>
</BaseLayout>
<style>
  .layout{max-width:1440px;margin:0 auto;padding:32px 32px 60px;display:grid;grid-template-columns:200px minmax(0,840px);gap:44px;justify-content:center}
  @media(max-width:820px){.layout{grid-template-columns:minmax(0,1fr);padding:22px 20px} :global(.rail){display:none}}
</style>
