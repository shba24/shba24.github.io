---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeftRail from '../../components/LeftRail.astro';
import EntryList from '../../components/EntryList.astro';
import type { EntryItem } from '../../components/EntryList.astro';
import { getEntry } from 'astro:content';

const blogs = await getEntry('pages', 'useful-technical-blogs');
if (!blogs) throw new Error("Missing content collection entry: pages/useful-technical-blogs");
const items: EntryItem[] = [
  { href: '/references/useful-technical-blogs/', title: blogs.data.title },
];
---
<BaseLayout title="References — Shubham Bansal">
  <div class="layout"><LeftRail />
    <main>
      <h1 class="page-title">References</h1>
      <EntryList items={items} />
    </main>
  </div>
</BaseLayout>
<style>
  .layout{max-width:1440px;margin:0 auto;padding:32px 32px 60px;display:grid;grid-template-columns:200px minmax(0,840px);gap:44px;justify-content:center}
  .page-title{font-size:1.6rem;font-weight:700;margin:0 0 20px}
  @media(max-width:820px){.layout{grid-template-columns:minmax(0,1fr);padding:22px 20px} :global(.rail){display:none}}
</style>
