---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeftRail from '../components/LeftRail.astro';
import EntryList from '../components/EntryList.astro';
import type { EntryItem } from '../components/EntryList.astro';
import JsonLd from '../components/JsonLd.astro';
import { buildWebsiteJsonLd } from '../lib/seo';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
const posts = (await getCollection('posts')).filter((p: CollectionEntry<'posts'>) => !p.data.draft)
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => b.data.date.valueOf() - a.data.date.valueOf());
const items: EntryItem[] = posts.map((p: CollectionEntry<'posts'>) => ({ href: `/posts/${p.id}/`, title: p.data.title, date: p.data.date }));
---
<BaseLayout title="Shubham Bansal — Technical Blog">
  <JsonLd data={buildWebsiteJsonLd()} />
  <div class="layout"><LeftRail />
    <main>
      <h1 class="page-title">Writing</h1>
      <EntryList items={items} />
    </main>
  </div>
</BaseLayout>
<style>
  .layout{max-width:var(--shell);margin:0 auto;padding:32px 32px 60px;display:grid;grid-template-columns:var(--rail) minmax(0,var(--content));gap:var(--gap);justify-content:center}
  .page-title{font-size:1.6rem;font-weight:700;margin:0 0 20px}
  @media(max-width:820px){.layout{grid-template-columns:minmax(0,1fr);padding:22px 20px} :global(.rail){display:none}}
</style>
