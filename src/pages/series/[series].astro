---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeftRail from '../../components/LeftRail.astro';
import EntryList from '../../components/EntryList.astro';
import type { EntryItem } from '../../components/EntryList.astro';
import { slugify } from '../../lib/format';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft && p.data.series);
  const map = new Map<string, { series: string; posts: typeof posts }>();
  for (const p of posts) {
    const name = p.data.series!;
    const slug = slugify(name);
    if (!map.has(slug)) map.set(slug, { series: name, posts: [] });
    map.get(slug)!.posts.push(p);
  }
  return [...map.entries()].map(([slug, v]) => ({
    params: { series: slug },
    props: {
      series: v.series,
      posts: v.posts.sort(
        (a, b) => (a.data.seriesPart ?? 0) - (b.data.seriesPart ?? 0) || a.data.date.valueOf() - b.data.date.valueOf(),
      ),
    },
  }));
}

interface Props { series: string; posts: CollectionEntry<'posts'>[] }
const { series, posts } = Astro.props;
const items: EntryItem[] = posts.map((p: CollectionEntry<'posts'>) => ({ href: `/posts/${p.id}/`, title: p.data.title, date: p.data.date }));
---
<BaseLayout title={`Series: ${series} — Shubham Bansal`}>
  <div class="layout"><LeftRail />
    <main>
      <h1 class="page-title">{series}</h1>
      <EntryList items={items} />
    </main>
  </div>
</BaseLayout>
<style>
  .layout{max-width:1440px;margin:0 auto;padding:32px 32px 60px;display:grid;grid-template-columns:200px minmax(0,840px);gap:44px;justify-content:center}
  .page-title{font-size:1.6rem;font-weight:700;margin:0 0 20px}
  @media(max-width:820px){.layout{grid-template-columns:minmax(0,1fr);padding:22px 20px} :global(.rail){display:none}}
</style>
