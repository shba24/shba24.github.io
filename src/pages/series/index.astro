---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeftRail from '../../components/LeftRail.astro';
import EntryList from '../../components/EntryList.astro';
import type { EntryItem } from '../../components/EntryList.astro';
import { slugify } from '../../lib/format';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const posts = (await getCollection('posts')).filter((p: CollectionEntry<'posts'>) => !p.data.draft && p.data.series);
const counts = new Map<string, { series: string; count: number }>();
for (const p of posts) {
  const name = p.data.series!;
  const slug = slugify(name);
  const cur = counts.get(slug);
  if (cur) cur.count += 1;
  else counts.set(slug, { series: name, count: 1 });
}
const items: EntryItem[] = [...counts.entries()]
  .sort((a: [string, { series: string; count: number }], b: [string, { series: string; count: number }]) => a[1].series.localeCompare(b[1].series))
  .map(([slug, v]: [string, { series: string; count: number }]) => ({
    href: `/series/${slug}/`,
    title: v.series,
    meta: `${v.count} ${v.count === 1 ? 'post' : 'posts'}`,
  }));
---
<BaseLayout title="Series — Shubham Bansal">
  <div class="shell"><LeftRail />
    <main>
      <h1 class="page-title">Series</h1>
      <EntryList items={items} />
    </main>
  </div>
</BaseLayout>
<style>
  .page-title{font-size:1.6rem;font-weight:700;margin:0 0 20px}
</style>
