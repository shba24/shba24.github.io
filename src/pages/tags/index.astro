---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeftRail from '../../components/LeftRail.astro';
import EntryList from '../../components/EntryList.astro';
import type { EntryItem } from '../../components/EntryList.astro';
import { slugify } from '../../lib/format';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const posts = (await getCollection('posts')).filter((p: CollectionEntry<'posts'>) => !p.data.draft);
const counts = new Map<string, { tag: string; count: number }>();
for (const p of posts) for (const t of p.data.tags) {
  const slug = slugify(t);
  const cur = counts.get(slug);
  if (cur) cur.count += 1;
  else counts.set(slug, { tag: t, count: 1 });
}
const items: EntryItem[] = [...counts.entries()]
  .sort((a: [string, { tag: string; count: number }], b: [string, { tag: string; count: number }]) => a[1].tag.localeCompare(b[1].tag))
  .map(([slug, v]: [string, { tag: string; count: number }]) => ({
    href: `/tags/${slug}/`,
    title: v.tag,
    meta: `${v.count} ${v.count === 1 ? 'post' : 'posts'}`,
  }));
---
<BaseLayout title="Tags — Shubham Bansal">
  <div class="layout"><LeftRail />
    <main>
      <h1 class="page-title">Tags</h1>
      <EntryList items={items} />
    </main>
  </div>
</BaseLayout>
<style>
  .layout{max-width:var(--shell);margin:0 auto;padding:32px 32px 60px;display:grid;grid-template-columns:var(--rail) minmax(0,var(--content));gap:var(--gap);justify-content:center}
  .page-title{font-size:1.6rem;font-weight:700;margin:0 0 20px}
  @media(max-width:820px){.layout{grid-template-columns:minmax(0,1fr);padding:22px 20px} :global(.rail){display:none}}
</style>
