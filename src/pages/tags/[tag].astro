---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeftRail from '../../components/LeftRail.astro';
import EntryList from '../../components/EntryList.astro';
import type { EntryItem } from '../../components/EntryList.astro';
import { slugify } from '../../lib/format';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { filterPosts, includeDrafts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = filterPosts(await getCollection('posts'), includeDrafts);
  const map = new Map<string, { tag: string; posts: typeof posts }>();
  for (const p of posts) for (const t of p.data.tags) {
    const slug = slugify(t);
    if (!map.has(slug)) map.set(slug, { tag: t, posts: [] });
    map.get(slug)!.posts.push(p);
  }
  return [...map.entries()].map(([slug, v]) => ({ params: { tag: slug }, props: { tag: v.tag, posts: v.posts } }));
}

interface Props { tag: string; posts: CollectionEntry<'posts'>[] }
const { tag, posts } = Astro.props;
const items: EntryItem[] = posts.map((p: CollectionEntry<'posts'>) => ({ href: `/posts/${p.id}/`, title: p.data.title, date: p.data.date }));
---
<BaseLayout title={`Tag: ${tag} — Shubham Bansal`}>
  <div class="shell"><LeftRail />
    <main>
      <h1 class="page-title">Tagged “{tag}”</h1>
      <EntryList items={items} />
    </main>
  </div>
</BaseLayout>
<style>
  .page-title{font-size:1.6rem;font-weight:700;margin:0 0 20px}
</style>
