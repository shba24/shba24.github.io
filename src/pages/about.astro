---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeftRail from '../components/LeftRail.astro';
import Prose from '../components/Prose.astro';
import { getEntry, render } from 'astro:content';

const about = await getEntry('pages', 'about');
if (!about) throw new Error("Missing content collection entry: pages/about");
const { Content } = await render(about);
---
<BaseLayout title={`${about.data.title} — Shubham Bansal`} description={about.data.description}>
  <div class="layout"><LeftRail />
    <main>
      <h1 class="page-title">{about.data.title}</h1>
      <Prose><Content /></Prose>
    </main>
  </div>
</BaseLayout>
<style>
  .layout{max-width:1440px;margin:0 auto;padding:32px 32px 60px;display:grid;grid-template-columns:200px minmax(0,840px);gap:44px;justify-content:center}
  .page-title{font-size:1.6rem;font-weight:700;margin:0 0 20px}
  @media(max-width:820px){.layout{grid-template-columns:minmax(0,1fr);padding:22px 20px} :global(.rail){display:none}}
</style>
