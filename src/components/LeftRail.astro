---
import { getCollection } from 'astro:content';
const all = (await getCollection('posts')).filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = all.slice(0, 3);
const recommended = [...new Set([...all.filter((p) => p.data.recommended), ...all])].slice(0, 3);
const byYear = new Map<number, number>();
for (const p of all) byYear.set(p.data.date.getFullYear(), (byYear.get(p.data.date.getFullYear()) ?? 0) + 1);
const archive = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---
<aside class="rail">
  <div class="sec"><h4>Latest</h4>{latest.map((p) => <a href={`/posts/${p.id}/`}>{p.data.title}</a>)}</div>
  <div class="sec"><h4>Recommended</h4>{recommended.map((p) => <a href={`/posts/${p.id}/`}>{p.data.title}</a>)}</div>
  <div class="sec"><h4>Archive</h4>{archive.map(([y, n]) => <a href="/posts/">{y} — {n} {n === 1 ? 'post' : 'posts'}</a>)}</div>
  <div class="foot">
    <a href="https://github.com/shba24" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.11.79-.25.79-.56 0-.27-.01-1-.015-1.96-3.2.69-3.87-1.54-3.87-1.54-.53-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14 0 1.54-.02 2.79-.02 3.17 0 .31.21.67.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg></a>
    <a href="https://www.linkedin.com/in/shba24/" aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0ZM.25 8.25h4.5V23H.25V8.25ZM8.5 8.25h4.31v2.02h.06c.6-1.14 2.07-2.34 4.26-2.34 4.56 0 5.4 3 5.4 6.9V23h-4.5v-6.53c0-1.56-.03-3.56-2.17-3.56-2.17 0-2.5 1.7-2.5 3.45V23H8.5V8.25Z"/></svg></a>
    <a href="/index.xml" aria-label="RSS" title="RSS"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4.44v3.06c7.06 0 12.5 5.44 12.5 12.5h3.06C19.56 11.35 12.65 4.44 4 4.44Zm0 5.66v3.06A6.84 6.84 0 0 1 10.84 20H13.9A9.9 9.9 0 0 0 4 10.1ZM6.18 16.4a2.18 2.18 0 1 0 0 4.36 2.18 2.18 0 0 0 0-4.36Z"/></svg></a>
  </div>
</aside>
<style>
  .rail{font-size:13px}
  .sec{margin-bottom:20px;padding-top:15px;border-top:1px solid var(--border-soft)}
  .sec:first-child{border-top:0;padding-top:0}
  .sec h4{margin:0 0 9px;font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--faint);font-weight:500}
  .sec a{display:block;color:var(--muted);padding:3px 0;line-height:1.35;font-size:12.5px}
  .sec a:hover{color:var(--accent)}
  .foot{margin-top:22px;padding-top:15px;border-top:1px solid var(--border-soft);display:flex;gap:16px;align-items:center}
  .foot a{color:var(--faint);display:inline-flex}
  .foot a:hover{color:var(--accent)}
  .foot svg{width:18px;height:18px;fill:currentColor;display:block}
</style>
