---
import Search from './Search.astro';
const path = Astro.url.pathname;
const active = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="topbar">
  <div class="tb">
    <a href="/" class="brand">Shubham Bansal</a>
    <nav class="tb-nav">
      <a href="/about/" aria-current={active('/about/') ? 'page' : undefined}>About</a>
      <a href="/posts/" aria-current={active('/posts/') ? 'page' : undefined}>Posts</a>
      <a href="/references/" aria-current={active('/references/') ? 'page' : undefined}>References</a>
      {import.meta.env.DEV && <a href="/drafts/" aria-current={active('/drafts/') ? 'page' : undefined}>Drafts</a>}
      {import.meta.env.DEV && <a href="/editor/" aria-current={active('/editor/') ? 'page' : undefined}>New</a>}
    </nav>
    <div class="tb-right">
      <Search />
      <button id="theme-toggle" class="tdot" aria-label="Toggle theme" aria-pressed="true"></button>
    </div>
  </div>
</header>
<style>
  .topbar{position:sticky;top:0;z-index:5;border-bottom:1px solid var(--border-soft);
    background:color-mix(in srgb,var(--bg) 82%,transparent);backdrop-filter:blur(8px)}
  .tb{max-width:var(--shell);margin:0 auto;padding:12px 32px;display:flex;align-items:center;gap:16px}
  .brand{font-weight:700;font-size:15px;letter-spacing:-.01em}
  .tb-nav{display:flex;gap:20px;margin-left:26px}
  .tb-nav a{font-size:15px;font-weight:500;color:var(--muted)}
  .tb-nav a:hover{color:var(--text)}
  .tb-nav a[aria-current="page"]{color:var(--text)}
  @media(max-width:520px){ .tb-nav{gap:14px;margin-left:14px} }
  .tb-right{margin-left:auto;display:flex;align-items:center;gap:14px}
  .tdot{width:15px;height:15px;border-radius:50%;border:1px solid var(--border);cursor:pointer;
    background:conic-gradient(var(--text) 0 50%, transparent 50% 100%)}
</style>
